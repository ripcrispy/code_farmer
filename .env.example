# Copy to .env (the server loads it automatically). All values are optional.

# Path to the server config file (default: config/server.json)
# CODEFARMER_CONFIG=config/server.json

# Override config values
# CODEFARMER_HOST=127.0.0.1
# CODEFARMER_PORT=3001
# CODEFARMER_DB=data/codefarmer.db

# Enables GET /admin/status with header "Authorization: Bearer <token>"
# CODEFARMER_ADMIN_TOKEN=change-me

# Client (Vite): WebSocket URL of the game server. Default: ws://<page host>:3001/ws
# VITE_SERVER_URL=ws://127.0.0.1:3001/ws
